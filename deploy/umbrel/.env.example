# Copy to .env and set values for your private BCHN node.
# Never commit the real .env file or RPC credentials.
BCHN_RPC_URL=http://192.168.1.50:8332
BCHN_RPC_USER=replace_with_rpc_username
BCHN_RPC_PASSWORD=replace_with_a_long_random_password
BCHN_RPC_TIMEOUT_MS=10000
BCHN_NETWORK=mainnet

# Optional ZMQ endpoint, only if BCHN is configured to publish raw blocks.
BCHN_ZMQ_RAWBLOCK=tcp://192.168.1.50:28332

STRATUM_BIND=0.0.0.0
STRATUM_PORT=3333
API_PORT=3334
POOL_IDENTIFIER=BCHN-SOLO
POOL_FEE_PERCENT=0

# Placeholder until service implementation defines and validates this setting.
DATA_DIR=/app/data
