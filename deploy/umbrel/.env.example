# Copy to deploy/umbrel/.env and replace every value.
# Keep BCHN RPC private. This file must never contain a wallet seed or private key.
BCHN_RPC_URL=192.168.1.20:8332
BCHN_RPC_USER=pooluser
BCHN_RPC_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
BCH_PAYOUT_ADDRESS=bitcoincash:qREPLACE_WITH_YOUR_OWN_ADDRESS

# Public coinbase scriptSig branding included in blocks mined by this pool.
COINBASE_TAG=Mine By Wx256-BCH SOLO POOL

# Leave false unless BCHN ZMQ is configured and reachable from this container.
BCHN_ZMQ_ENABLED=false
BCHN_ZMQ_URL=tcp://host.docker.internal:28332
STRATUM_PORT=3333
POOL_FEE_PERCENT=0
MIN_SHARE_DIFFICULTY=1
START_SHARE_DIFFICULTY=42
