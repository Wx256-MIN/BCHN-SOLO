# Copy to .env and replace every example value. Never commit real credentials.
# BCHN RPC must be reachable from the pool container; do not expose RPC publicly.
BCHN_RPC_URL=192.168.1.20:8332
BCHN_RPC_USER=pooluser
BCHN_RPC_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Use a valid BCH CashAddr for your wallet. Replace this example before starting.
BCH_PAYOUT_ADDRESS=bitcoincash:qREPLACE_WITH_YOUR_OWN_ADDRESS

# Keep at 0 for a zero-fee solo pool.
POOL_FEE_PERCENT=0

# Enable only when BCHN ZMQ block notifications are configured and reachable.
BCHN_ZMQ_ENABLED=false
BCHN_ZMQ_URL=tcp://192.168.1.20:28332

STRATUM_PORT=3333
MIN_SHARE_DIFFICULTY=1
START_SHARE_DIFFICULTY=42
